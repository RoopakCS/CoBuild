# Database configuration (Supabase PostgreSQL URL, Username, Password)
DB_URL=jdbc:postgresql://db.xxxx.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=your_supabase_db_password

# Security / JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_at_least_256_bits_long
JWT_EXPIRATION=86400000

# Dynamic CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://cobuildapp.vercel.app,https://cobuildapp.live,https://www.cobuildapp.live

# Connection Pool Settings
HIKARI_MAX_POOL_SIZE=5

# Port configuration (Injected by hosting platform like Render/Railway)
PORT=8080
